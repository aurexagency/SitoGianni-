---
/**
 * Services.astro — Griglia 2×2 card chiuse, stile Earthy Tech / Dark Mode
 * Ispirato alla reference "On Consult": icona + titolo in riga, desc sotto, CTA in fondo.
 */

const cards = [
  {
    id: 'service-card-geologia',
    tag: 'Geologia',
    label: 'Geologia applicata',
    titleHtml: '<span class="accent-initial">G</span>eologia e <span class="accent-initial">G</span>eotecnica',
    title: 'Geologia e Geotecnica',
    desc: `<ul class="service-list">
      <li>Relazioni geologiche, geotecniche e sismiche</li>
      <li>Modelli geologici e geotecnici</li>
      <li>Studi per edifici, opere civili e infrastrutture</li>
      <li>Analisi di stabilità dei versanti</li>
      <li>Programmazione ed esecuzione indagini geognostiche</li>
    </ul>`,
    ctaLabel: 'Chiedi una Consulenza',
    icon: `<path d="M4 36 L14 20 L24 28 L34 16 L44 36 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
           <path d="M4 42 L44 42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
           <circle cx="14" cy="20" r="2" fill="currentColor" opacity="0.7"/>
           <circle cx="24" cy="28" r="2" fill="currentColor" opacity="0.7"/>
           <circle cx="34" cy="16" r="2" fill="currentColor" opacity="0.7"/>`,
  },
  {
    id: 'service-card-idrogeologia',
    tag: 'Idrogeologia',
    label: 'Idrogeologia',
    titleHtml: '<span class="accent-initial">I</span>drogeologia e <span class="accent-initial">R</span>isorse <span class="accent-initial">I</span>driche',
    title: 'Idrogeologia e Risorse Idriche',
    desc: `<ul class="service-list">
      <li>Studi idrogeologici e caratterizzazione degli acquiferi</li>
      <li>Ricerca e progettazione di pozzi</li>
      <li>Autorizzazioni per derivazioni e captazioni idriche</li>
      <li>Gestione e tutela delle risorse idriche sotterranee</li>
      <li>Campionamenti e monitoraggi delle acque sotterranee e superficiali</li>
    </ul>`,
    ctaLabel: 'Chiedi una Consulenza',
    icon: `<path d="M24 6 C24 6 12 18 12 28 C12 35.2 17.4 41 24 41 C30.6 41 36 35.2 36 28 C36 18 24 6 24 6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
           <path d="M18 32 Q24 26 30 32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.6"/>
           <path d="M16 38 Q24 31 32 38" stroke="currentColor" stroke-width="1" stroke-linecap="round" fill="none" opacity="0.35"/>`,
  },
  {
    id: 'service-card-ambiente',
    tag: 'Ambiente',
    label: 'Valutazioni ambientali',
    titleHtml: '<span class="accent-initial">A</span>mbiente e <span class="accent-initial">T</span>erritorio',
    title: 'Ambiente e Territorio',
    desc: `<ul class="service-list">
      <li>Studi ambientali e territoriali</li>
      <li>Terre e rocce da scavo</li>
      <li>Progettazione e AUTORIZZAZIONI per impianti.......</li>
      <li>Supporto alla progettazione ambientale</li>
      <li>Consulenza ambientale nei cantieri temporanei e mobili</li>
    </ul>`,
    ctaLabel: 'Chiedi una Consulenza',
    icon: `<circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="1.5" fill="none"/>
           <path d="M24 6 C14 14 10 22 14 32 C18 38 30 38 34 32 C38 22 34 14 24 6Z" stroke="currentColor" stroke-width="1" fill="none" opacity="0.5"/>
           <path d="M6 24 L42 24" stroke="currentColor" stroke-width="1" opacity="0.35"/>
           <path d="M24 6 L24 42" stroke="currentColor" stroke-width="1" opacity="0.35"/>`,
  },
  {
    id: 'service-card-energia',
    tag: 'Energia',
    label: 'Energia e geotermia',
    titleHtml: '<span class="accent-initial">E</span>nergia e <span class="accent-initial">I</span>nfrastrutture',
    title: 'Energia e Infrastrutture',
    desc: `<ul class="service-list">
      <li>Studi geologici per impianti fotovoltaici e agrivoltaici</li>
      <li>Opere connesse e infrastrutture energetiche</li>
      <li>Supporto agli iter autorizzativi</li>
      <li>Studi per opere viarie e infrastrutturali</li>
      <li>Consulenza geologica nelle fasi progettuali e realizzative</li>
    </ul>`,
    ctaLabel: 'Chiedi una Consulenza',
    icon: `<path d="M26 6 L16 26 L22 26 L20 42 L34 20 L28 20 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
           <path d="M8 38 Q12 35 16 38 Q20 41 24 38" stroke="currentColor" stroke-width="1" stroke-linecap="round" fill="none" opacity="0.45"/>
           <path d="M8 43 Q12 40 16 43 Q20 46 24 43" stroke="currentColor" stroke-width="1" stroke-linecap="round" fill="none" opacity="0.25"/>`,
  },
];
---

<section
  class="services section section--padded-xl"
  id="services"
  aria-label="Servizi offerti"
  data-section="services"
>
  <div class="container services__inner">

    <!-- Section label -->
    <div class="section-label" data-gsap="fade-up">
      <span class="section-label__line" aria-hidden="true"></span>
      <span class="mono text-muted section-label__text">02 / Servizi</span>
    </div>

    <!-- Intro headline -->
    <div class="services__header" data-gsap="fade-up" data-gsap-delay="0.1">
      <h2 class="services__headline heading-xl">
        <span class="accent-initial">S</span>ERVIZI <span class="accent-initial">P</span>ROFESSIONALI
      </h2>
      <p class="services__intro body-lg text-secondary">
        Dalla conoscenza del sottosuolo alla gestione delle criticità geologiche: Consulenza tecnica per Privati, Progettisti ed Enti.
      </p>
    </div>

    <!-- Cards Grid 2×2 -->
    <div
      class="services__cards-grid"
      role="list"
      aria-label="Lista servizi"
    >
      {cards.map((card) => (
        <article
          class="service-card"
          id={card.id}
          role="listitem"
          data-tag={card.tag}
          tabindex="0"
          aria-label={card.label}
        >
          <div class="service-card__inner">

            <!-- Top accent bar (hover) -->
            <div class="service-card__accent" aria-hidden="true"></div>

            <!-- Card Header: icona top-left + titolo centrato -->
            <header class="service-card__header">
              <div class="service-card__icon" aria-hidden="true">
                <svg
                  class={`icon icon--${card.tag.toLowerCase()}`}
                  viewBox="0 0 48 48"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  set:html={card.icon}
                />
              </div>
              <h3 class="service-card__title" set:html={card.titleHtml}></h3>
            </header>

            <!-- Card Body: lista descrizione -->
            <div class="service-card__content">
              <div class="service-card__desc" set:html={card.desc}></div>
            </div>

            <!-- CTA in fondo -->
            <footer class="service-card__footer">
              <a
                href={`#contact`}
                class="service-card__cta"
                aria-label={`${card.ctaLabel} — ${card.title}`}
              >
                <span>{card.ctaLabel}</span>
              </a>
            </footer>

          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Accent iniziali terracotta ── */
  :global(.accent-initial) {
    color: var(--clr-accent);
  }

  /* ── Card Header: icona top-right + titolo al centro ── */
  .service-card__header {
    position: relative;
    text-align: center;
    margin-bottom: var(--sp-4);
    padding-top: var(--sp-2);
  }

  /* ── Icona in alto a destra assoluta ── */
  .service-card__icon {
    position: absolute;
    top: -12px;
    right: -8px;
    width: 32px;
    height: 32px;
    color: var(--clr-accent);
    transition: transform var(--dur-base) var(--ease-out-expo),
                filter var(--dur-base);
  }

  .service-card__icon svg {
    width: 32px;
    height: 32px;
  }

  /* ── Titolo centrato e ingrandito ── */
  .service-card__title {
    font-family: var(--ff-display);
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--clr-text-primary);
    display: inline-block;
    transition: color var(--dur-base);
    margin: 0;
  }



  /* ── Body: descrizione ── */
  .service-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* ── Lista items molto più stretta ── */
  .service-card__desc :global(.service-list) {
    list-style: none;
    padding: 0 var(--sp-2);
    margin: 0;
  }

  .service-card__desc :global(.service-list li) {
    position: relative;
    padding-left: var(--sp-4);
    font-size: 0.9rem;
    line-height: 1.3;
    margin-bottom: 8px; /* Interlinea fissa dimezzata */
    color: var(--clr-text-secondary);
    transition: color var(--dur-fast);
  }

  .service-card__desc :global(.service-list li:last-child) {
    margin-bottom: 0;
  }

  .service-card__desc :global(.service-list li::before) {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--clr-accent);
    opacity: 0.65;
    font-weight: 600;
  }

  /* ── Footer CTA ── */
  .service-card__footer {
    margin-top: var(--sp-5);
    display: flex;
    justify-content: center;
  }

  /* Bottone CTA in stile pill pieno */
  .service-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    border-radius: var(--radius-sm, 8px);
    background-color: var(--clr-accent);
    font-family: var(--ff-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: #1a1a1a; /* Testo scuro su fondo terracotta */
    text-decoration: none;
    transition: background-color var(--dur-fast), transform var(--dur-fast) var(--ease-out-expo);
  }

  .service-card__cta-arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }

  /* ── Hover su tutta la card ── */
  .service-card:hover .service-card__icon,
  .service-card:focus-visible .service-card__icon {
    transform: scale(1.1);
    filter: drop-shadow(0 0 8px var(--clr-accent-dim));
  }



  .service-card:hover .service-card__cta,
  .service-card:focus-visible .service-card__cta {
    background-color: var(--clr-accent-light);
    transform: scale(1.03);
  }

  .service-card:hover .service-card__desc :global(.service-list li),
  .service-card:focus-visible .service-card__desc :global(.service-list li) {
    color: var(--clr-text-primary);
  }



  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .service-card__cta,
    .service-card__accent {
      transition: none;
    }
  }
</style>
