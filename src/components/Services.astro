---
/**
 * Services.astro — §3 Timed Cards interattive
 * 4 macro-aree con GSAP Flip carousel automatico.
 * I dati delle card vengono definiti nel frontmatter per facilità di editing.
 */

const cards = [
  {
    id: 'service-card-geologia',
    index: '01',
    tag: 'Geologia',
    label: 'Geologia applicata',
    title: 'Geologia e Geotecnica',
    desc: `<ul class="service-list">
      <li>Relazioni geologiche, geotecniche e sismiche</li>
      <li>Modelli <span class="text-neon-green">geologici e geotecnici</span></li>
      <li>Studi per edifici, opere civili e infrastrutture</li>
      <li><span class="text-neon-green">Analisi di stabilità</span> dei versanti</li>
      <li>Programmazione ed esecuzione <span class="text-neon-green">indagini geognostiche</span></li>
    </ul>`,
    tags: ['Studio del suolo', 'Relazioni PdC', 'Mappatura'],
    ctaLabel: 'Approfondisci Geologia',
    icon: `<path d="M4 36 L14 20 L24 28 L34 16 L44 36 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
           <path d="M4 42 L44 42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
           <circle cx="14" cy="20" r="2" fill="currentColor" opacity="0.7"/>
           <circle cx="24" cy="28" r="2" fill="currentColor" opacity="0.7"/>
           <circle cx="34" cy="16" r="2" fill="currentColor" opacity="0.7"/>`,
  },
  {
    id: 'service-card-idrogeologia',
    index: '02',
    tag: 'Idrogeologia',
    label: 'Idrogeologia',
    title: 'Idrogeologia e Risorse Idriche',
    desc: `<ul class="service-list">
      <li>Studi idrogeologici e <span class="text-neon-green">caratterizzazione degli acquiferi</span></li>
      <li>Ricerca e progettazione di pozzi</li>
      <li>Autorizzazioni per derivazioni e captazioni idriche</li>
      <li>Gestione e tutela delle <span class="text-neon-green">risorse idriche sotterranee</span></li>
      <li>Campionamenti e monitoraggi delle acque sotterranee e superficiali</li>
    </ul>`,
    tags: ['Acque sotterranee', 'Pozzi', 'Rischio idraulico'],
    ctaLabel: 'Approfondisci Idrogeologia',
    icon: `<path d="M24 6 C24 6 12 18 12 28 C12 35.2 17.4 41 24 41 C30.6 41 36 35.2 36 28 C36 18 24 6 24 6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
           <path d="M18 32 Q24 26 30 32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.6"/>
           <path d="M16 38 Q24 31 32 38" stroke="currentColor" stroke-width="1" stroke-linecap="round" fill="none" opacity="0.35"/>`,
  },
  {
    id: 'service-card-ambiente',
    index: '03',
    tag: 'Ambiente',
    label: 'Valutazioni ambientali',
    title: 'Ambiente e Territorio',
    desc: `<ul class="service-list">
      <li>Studi ambientali e territoriali</li>
      <li>Terre e rocce da scavo</li>
      <li>Progettazione per impianti di <span class="text-neon-green">trattamento e smaltimento rifiuti</span></li>
      <li>Supporto alla progettazione ambientale</li>
      <li>Consulenza ambientale nei <span class="text-neon-green">cantieri temporanei e mobili</span></li>
    </ul>`,
    tags: ['Bonifica', 'VIA / VAS', 'Analisi rischio'],
    ctaLabel: 'Approfondisci Ambiente',
    icon: `<circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="1.5" fill="none"/>
           <path d="M24 6 C14 14 10 22 14 32 C18 38 30 38 34 32 C38 22 34 14 24 6Z" stroke="currentColor" stroke-width="1" fill="none" opacity="0.5"/>
           <path d="M6 24 L42 24" stroke="currentColor" stroke-width="1" opacity="0.35"/>
           <path d="M24 6 L24 42" stroke="currentColor" stroke-width="1" opacity="0.35"/>`,
  },
  {
    id: 'service-card-energia',
    index: '04',
    tag: 'Energia',
    label: 'Energia e geotermia',
    title: 'Energia e Infrastrutture',
    desc: `<ul class="service-list">
      <li>Studi geologici per impianti <span class="text-neon-green">fotovoltaici e agrivoltaici</span></li>
      <li>Opere connesse e infrastrutture energetiche</li>
      <li>Supporto agli iter autorizzativi</li>
      <li>Studi per opere viarie e infrastrutturali</li>
      <li><span class="text-neon-green">Consulenza geologica</span> nelle fasi progettuali e realizzative</li>
    </ul>`,
    tags: ['Geotermia', 'Pompe di calore', "Sostenibilita'"],
    ctaLabel: 'Approfondisci Energia',
    icon: `<path d="M26 6 L16 26 L22 26 L20 42 L34 20 L28 20 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
           <path d="M8 38 Q12 35 16 38 Q20 41 24 38" stroke="currentColor" stroke-width="1" stroke-linecap="round" fill="none" opacity="0.45"/>
           <path d="M8 43 Q12 40 16 43 Q20 46 24 43" stroke="currentColor" stroke-width="1" stroke-linecap="round" fill="none" opacity="0.25"/>`,
  },
];
---

<section
  class="services section section--padded-xl"
  id="services"
  aria-label="Servizi offerti"
  data-section="services"
>
  <div class="container services__inner">

    <!-- Section label -->
    <div class="section-label" data-gsap="fade-up">
      <span class="section-label__line" aria-hidden="true"></span>
      <span class="mono text-muted section-label__text">02 / Servizi</span>
    </div>

    <!-- Intro headline -->
    <div class="services__header" data-gsap="fade-up" data-gsap-delay="0.1">
      <h2 class="services__headline heading-xl">
        SERVIZI PROFESSIONALI
      </h2>
      <p class="services__intro body-lg text-secondary">
        Dalla conoscenza del sottosuolo alla gestione delle criticità geologiche: Consulenza tecnica per Privati, Progettisti ed Enti.
      </p>
    </div>

    <!-- Timed Cards Grid -->
    <div
      class="services__cards-grid"
      role="list"
      aria-label="Lista servizi"
      data-gsap="stagger-cards"
    >
      {cards.map((card) => (
        <article
          class="service-card"
          id={card.id}
          role="listitem"
          data-index={card.index}
          data-tag={card.tag}
          tabindex="0"
          aria-label={card.label}
        >
          <div class="service-card__inner">
            <div class="service-card__accent" aria-hidden="true"></div>

            <!-- Colonna sinistra: indice + icona -->
            <div class="service-card__left">
              <span class="service-card__index mono text-muted">{card.index}</span>
              <div class="service-card__icon" aria-hidden="true">
                <svg
                  class={`icon icon--${card.tag.toLowerCase()}`}
                  viewBox="0 0 48 48"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  set:html={card.icon}
                />
              </div>
            </div>

            <!-- Colonna destra: titolo + desc -->
            <div class="service-card__content">
              <h3 class="service-card__title heading-md">{card.title}</h3>
              <p class="service-card__desc body-sm text-secondary" set:html={card.desc}></p>
            </div>

            <!-- Progress bar per Timed Cards -->
            <div class="service-card__progress-bar" aria-hidden="true"></div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .service-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .service-card__desc :global(.service-list) {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  
  .service-card__desc :global(.service-list li) {
    position: relative;
    padding-left: var(--sp-5);
    line-height: var(--lh-loose);
    font-size: 1.1rem;
  }
  
  .service-card__desc :global(.service-list li::before) {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--clr-neon-green);
    opacity: 0.6;
    font-weight: 600;
  }
</style>
