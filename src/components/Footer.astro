---
/**
 * Footer.astro — Site Footer
 * Brand, nav links, copyright.
 * L'anno viene calcolato lato server da Astro (SSG).
 */
const year = new Date().getFullYear();
---

<footer class="site-footer" id="site-footer" role="contentinfo">
  <div class="container site-footer__inner">

    <div class="site-footer__brand">
      <span class="nav__logo-prefix mono">geo.</span>
      <span class="nav__logo-name">Bastreghi</span>
      <p class="site-footer__tagline body-sm text-muted">
        Dott. Geol. Gianni Bastreghi<br />
        <span class="mono">P.IVA 01655350534</span>
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Navigazione footer">
      <ul role="list">
        <li><a class="footer-link" href="#vision">Chi sono</a></li>
        <li><a class="footer-link" href="#services">Servizi</a></li>
        <li><a class="footer-link" href="#contact">Contatti</a></li>
        <li><a class="footer-link" href="/privacy">Privacy</a></li>
      </ul>
    </nav>

    <p class="site-footer__copy mono text-muted body-sm">
      &copy; {year} — Tutti i diritti riservati.
    </p>

  </div>
</footer>

<script>
  function setupFooterReveal() {
    const footer = document.getElementById('site-footer');
    const main = document.getElementById('main-content');
    
    if (!footer || !main) return;
    
    // Rispetta l'accessibilità: se l'utente preferisce ridurre le animazioni, usiamo il footer standard
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (rm) {
      footer.style.position = 'static';
      main.style.marginBottom = '0';
      return;
    }

    // Configura il footer "a scomparsa" (fixed dietro al main)
    footer.style.position = 'fixed';
    footer.style.bottom = '0';
    footer.style.left = '0';
    footer.style.width = '100%';
    footer.style.zIndex = '-1';
    
    // Assicura che il main copra il footer
    main.style.position = 'relative';
    main.style.zIndex = '1';
    main.style.backgroundColor = 'var(--clr-bg-base)';

    // Aggiorna il margin-bottom del main in base all'altezza dinamica del footer
    const updateMargin = () => {
      main.style.marginBottom = `${footer.offsetHeight}px`;
    };
    
    // Inizializzazione e listener
    updateMargin();
    window.addEventListener('resize', updateMargin);
    
    // Cleanup per le Astro View Transitions
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('resize', updateMargin);
    }, { once: true });
  }

  // Esegui ad ogni navigazione della pagina
  document.addEventListener('astro:page-load', setupFooterReveal);
</script>
