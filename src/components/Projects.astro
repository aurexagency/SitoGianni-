---
/**
 * Projects.astro — §4 Casi Studio / Progetti Rilevanti
 *
 * Layout editoriale a griglia asimmetrica:
 *   - Un progetto "featured" a piena larghezza in alto
 *   - Una griglia 3-colonne per i progetti secondari
 *
 * Tutte le animazioni usano gli attributi data-gsap
 * riconosciuti da src/scripts/animations.ts (gsap-init.ts).
 */

const projects = [
  {
    id: 'project-featured',
    index: '01',
    category: 'Geologia & Geotecnica',
    title: 'Caratterizzazione geotecnica per complesso residenziale',
    desc: 'Indagine geologica e geotecnica approfondita su un lotto di 8.500 m² in zona sismica 2. Esecuzione di sondaggi, prove penetrometriche e modellazione sismica per la progettazione delle fondazioni di un complesso di 6 corpi scala.',
    tags: ['Sismica', 'Sondaggi', 'Zona S2'],
    year: '2023',
    featured: true,
  },
  {
    id: 'project-idro',
    index: '02',
    category: 'Idrogeologia',
    title: 'Studio e progettazione pozzo irriguo',
    desc: 'Ricerca idrogeologica, progettazione e direzione lavori di un pozzo da 120 m per uso irriguo in area agricola. Ottenimento concessione di derivazione.',
    tags: ['Pozzi', 'Derivazione', 'Acquiferi'],
    year: '2023',
    featured: false,
  },
  {
    id: 'project-fotovoltaico',
    index: '03',
    category: 'Energia & Infrastrutture',
    title: 'Studio geologico per impianto agrivoltaico da 8 MWp',
    desc: "Relazione geologica e geotecnica per iter autorizzativo VIA di un parco agrivoltaico. Valutazione della pericolosità geomorfologica e sismica dell'area.",
    tags: ['Fotovoltaico', 'VIA', 'Rinnovabili'],
    year: '2024',
    featured: false,
  },
  {
    id: 'project-bonifica',
    index: '04',
    category: 'Ambiente & Territorio',
    title: 'Piano di caratterizzazione sito industriale dismesso',
    desc: 'Indagine ambientale preliminare e piano di caratterizzazione per ex area produttiva. Campionamento suolo e acque sotterranee, analisi di rischio sito-specifica.',
    tags: ['Bonifica', 'Analisi Rischio', 'Ex-industriale'],
    year: '2024',
    featured: false,
  },
];

const featured = projects.find(p => p.featured);
const grid = projects.filter(p => !p.featured);
---

<section
  class="projects section section--padded-xl"
  id="projects"
  aria-label="Casi studio e progetti rilevanti"
  data-section="projects"
>
  <div class="container projects__inner">

    <!-- ─── SECTION LABEL ─────────────────────────────────── -->
    <div class="section-label" data-gsap="fade-up">
      <span class="section-label__line" aria-hidden="true"></span>
      <span class="mono text-muted section-label__text">03 / Casi Studio</span>
    </div>

    <!-- ─── HEADER ────────────────────────────────────────── -->
    <div class="projects__header" data-gsap="fade-up" data-gsap-delay="0.1">
      <h2 class="projects__headline heading-xl">
        <span class="text-neon-green">P</span>ROGETTI <span class="text-neon-green">R</span>ILEVANTI
      </h2>
      <p class="projects__intro body-lg text-secondary">
        Una selezione di interventi significativi, dalla caratterizzazione del sottosuolo alle autorizzazioni ambientali.
      </p>
    </div>

    <!-- ─── FEATURED PROJECT ──────────────────────────────── -->
    {featured && (
      <article
        class="project-featured"
        id={featured.id}
        aria-label={`Progetto in evidenza: ${featured.title}`}
        data-gsap="fade-up"
        data-gsap-delay="0.15"
      >
        <div class="project-featured__inner">
          <div class="project-featured__meta">
            <span class="project-featured__index mono text-muted">{featured.index}</span>
            <span class="project-featured__category mono text-neon-green">{featured.category}</span>
            <span class="project-featured__year mono text-muted">{featured.year}</span>
          </div>
          <div class="project-featured__content">
            <h3 class="project-featured__title heading-md">{featured.title}</h3>
            <p class="project-featured__desc body-lg text-secondary">{featured.desc}</p>
            <ul class="project-tags" aria-label="Tag progetto">
              {featured.tags.map(tag => (
                <li class="project-tag mono">{tag}</li>
              ))}
            </ul>
          </div>
          <div class="project-featured__badge" aria-hidden="true">
            <span class="mono">IN EVIDENZA</span>
          </div>
        </div>
      </article>
    )}

    <!-- ─── PROJECTS GRID ─────────────────────────────────── -->
    <div
      class="projects__grid"
      role="list"
      aria-label="Lista casi studio"
      data-gsap="stagger-cards"
    >
      {grid.map((project) => (
        <article
          class="project-card"
          id={project.id}
          role="listitem"
          aria-label={project.title}
          tabindex="0"
        >
          <div class="project-card__inner">
            <div class="project-card__meta">
              <span class="project-card__index mono text-muted">{project.index}</span>
              <span class="project-card__year mono text-muted">{project.year}</span>
            </div>
            <span class="project-card__category mono text-neon-green">{project.category}</span>
            <h3 class="project-card__title heading-md">{project.title}</h3>
            <p class="project-card__desc body-sm text-secondary">{project.desc}</p>
            <ul class="project-tags" aria-label="Tag progetto">
              {project.tags.map(tag => (
                <li class="project-tag mono">{tag}</li>
              ))}
            </ul>
            <div class="project-card__line" aria-hidden="true"></div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>


<style>
  /* ── Section ─────────────────────────────────────────────── */
  .projects__inner {
    position: relative;
    z-index: var(--z-content);
  }

  .projects__header {
    margin-bottom: var(--sp-12);
    max-width: 720px;
  }

  .projects__headline {
    margin-bottom: var(--sp-4);
  }

  /* ── Featured Project ────────────────────────────────────── */
  .project-featured {
    background: var(--clr-bg-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-8);
    margin-bottom: var(--sp-8);
    position: relative;
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease-out-expo);
  }

  .project-featured::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--clr-neon-green), transparent);
    opacity: 0.5;
  }

  .project-featured:hover {
    border-color: var(--clr-border-hover);
  }

  .project-featured__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--sp-8);
    align-items: start;
  }

  .project-featured__meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding-top: var(--sp-1);
  }

  .project-featured__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .project-featured__title {
    color: var(--clr-text-primary);
  }

  .project-featured__badge {
    border: 1px solid var(--clr-neon-green);
    border-radius: var(--radius-pill);
    padding: var(--sp-1) var(--sp-3);
    color: var(--clr-neon-green);
    font-size: var(--fz-mono-sm);
    white-space: nowrap;
    align-self: flex-start;
  }

  /* ── Projects Grid ───────────────────────────────────────── */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }

  .project-card {
    background: var(--clr-bg-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-md);
    padding: var(--sp-6);
    position: relative;
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease-out-expo),
                transform var(--dur-base) var(--ease-out-expo),
                background var(--dur-base);
    cursor: default;
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: var(--clr-border-hover);
    background: var(--clr-bg-elevated);
    transform: translateY(-4px);
  }

  .project-card__inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
  }

  .project-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .project-card__category {
    font-size: var(--fz-mono-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card__title {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.2;
    color: var(--clr-text-primary);
  }

  .project-card__desc {
    flex: 1;
    line-height: var(--lh-loose);
  }

  .project-card__line {
    height: 1px;
    background: var(--clr-border);
    margin-top: auto;
    transition: background var(--dur-base);
  }

  .project-card:hover .project-card__line {
    background: var(--clr-neon-green);
    opacity: 0.4;
  }

  /* ── Tags ────────────────────────────────────────────────── */
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-tag {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clr-text-muted);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-pill);
    padding: 2px var(--sp-2);
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .project-featured__inner {
      grid-template-columns: auto 1fr;
    }

    .project-featured__badge {
      grid-column: 2;
      justify-self: start;
    }
  }

  @media (max-width: 700px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }

    .project-featured {
      padding: var(--sp-5);
    }

    .project-featured__inner {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }

    .project-featured__meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--sp-3);
    }
  }

  /* ── Prefers reduced motion ──────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-featured {
      transition: none;
    }
  }
</style>
