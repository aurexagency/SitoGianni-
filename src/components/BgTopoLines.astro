---
/**
 * BgTopoLines.astro — Linee topografiche di sfondo decorative (SVG)
 */
---

<div id="bg-topo-lines" aria-hidden="true">
  <svg width="100%" height="100%" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path class="bg-topo-path" d="M -100,200 Q 300,50 600,300 T 1200,100" />
    <path class="bg-topo-path" d="M -100,500 Q 400,200 800,600 T 1400,300" />
    <path class="bg-topo-path" d="M -200,800 Q 300,900 700,500 T 1500,700" />
    <path class="bg-topo-path" d="M 100,-100 Q 200,400 600,600 T 1100,1200" />
  </svg>
</div>
